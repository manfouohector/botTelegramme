# ============================================================
# .env.example — Prediction Engine Python (DevMind Bot)
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer .env dans git
# ============================================================

# ---- Environnement ----
PYTHON_PORT=8000
ENVIRONMENT=development

# ---- Base de données PostgreSQL (même base que le backend Node) ----
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---- Sécurité interne ----
INTERNAL_API_KEY=change_me_to_a_random_secret_string

# ---- LLM ----
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Modèles ML ----
MODEL_DIR=./app/models/saved
