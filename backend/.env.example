# ============================================================
# .env.example — Backend Node.js (DevMind Bot)
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer .env dans git
# ============================================================

# ---- Environnement ----
NODE_ENV=development
PORT=3000

# ---- Base de données PostgreSQL (Neon.tech ou Supabase) ----
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---- API Sources de données ----
API_FOOTBALL_KEY=your_api_football_key_here
FOOTBALL_DATA_ORG_KEY=your_football_data_org_key_here

# ---- Quota API-Football ----
QUOTA_DAILY_LIMIT=100
QUOTA_SAFETY_THRESHOLD=90
# ⚠️ Plan gratuit : saisons 2022-2024 seulement. Mettre à jour après upgrade du plan.
API_FOOTBALL_SEASON=2024

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_FREE_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_PREMIUM_GROUP_ID=-100xxxxxxxxxx
TELEGRAM_ADMIN_ID=your_telegram_user_id_here

# ---- Paiements (V1 — Manuel WhatsApp) ----
WHATSAPP_NUMBER=237612345678
MOBILE_MONEY_NUMBER=237612345678
MOBILE_MONEY_PROVIDER=MTN

# ---- Abonnement ----
SUBSCRIPTION_DURATION_DAYS=30
SUBSCRIPTION_PRICE_FCFA=2500

# ---- Communication interne Node ↔ Python ----
INTERNAL_API_KEY=change_me_to_a_random_secret_string
PREDICTION_ENGINE_URL=http://localhost:8000

# ---- LLM (géré côté Python mais référencé ici pour info) ----
# Ces clés sont à mettre dans prediction-engine/.env
# GROQ_API_KEY=
# GEMINI_API_KEY=
